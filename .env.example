# Copy to .env and fill in. Only the API key is required.
FIREWORKS_API_KEY=

# Optional overrides (defaults shown)
# CHAT_MODEL=accounts/fireworks/models/glm-5p3        # answer model; glm-5p3-flash is cheaper (31/32 in our comparison)
# JUDGE_MODEL=accounts/fireworks/models/deepseek-v4p1-flash   # evaluation judge only
# AGENT_TIME_BUDGET_S=90                               # per-question time budget
# PLANNER=off                                          # "auto" or "on" to plan before researching (UI toggle does this per question)
# PORT=8000
